                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Loops"
          },
          "next_actions": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskRead"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Actions"
          },
          "important_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Important Context"
          }
        },
        "type": "object",
        "title": "ContextRead"
      },
